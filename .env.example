# Agent1 Omni — the agent that beats every other agent
# Copy to .env and fill in. NEVER commit .env

# OpenRouter (free models = $0). Get one at https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Optional overrides
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# AGENT1_MODEL=qwen/qwen3-coder:free
# AGENT1_WORKSPACE=./workspace
# AGENT1_APPROVAL=safe            # auto | safe | manual
# AGENT1_MAX_STEPS=25
# AGENT1_TASK=general             # general | code | research | reason | fast
# AGENT1_DEMO=0                   # 1 = offline demo (no key/network)
# AGENT1_PLUGINS=                 # dir of extra tool .py files (off if empty)
# AGENT1_HISTORY_BUDGET=60000     # chars before context compaction kicks in
# AGENT1_WEB_TIMEOUT=25
